C o m p i l a t i o n


   3  option lp = mosek;
   4   
   5  SETS
   6              T       List of all time Hours
   7  * this means all hours from 1 to 744
   8                      /1*745/;
   9   
  10  PARAMETERS
  11  C_coal(T)     Cost of coal per unit for each hour
  12  C_gas(T)      Cost of gas per unit for each hour
  13  C_solar(T)    Cost of solar per unit for each hour
  14  PRD_DATA(T)   Input data for production quantity
  15  MAX_Marg(T)   Maximum marginal cost for each hour
  16  d(T)   Demand for each hour;
  17   
  18  C_coal(T) = 7.8; # $/MWhTh
  19  C_gas(T) = 19.8; # $/MWhTh
  20   
GDXIN   C:\Intro to GAMs\demand(in).gdx
--- LOAD  d = 1:d
  25   
  26  PRD_DATA(T) = d(T); #MWh
  27   
  28  VARIABLES
  29  TOTCost     Total cost of emissions for all hours
  30  Cost(T)     Total cost for each hour
  31  U_solar(T)     Utilization of solar energy for each hour
  32  U_Coal(T)     Utilization of coal energy for each hour
  33  U_Gas(T)     Utilization of gas energy for each hour
  34  Plant1(T)   Production for Plant 1 for each hour
  35  Plant2(T)   Production for Plant 2 for each hour
  36  Plant3(T)   Production for Plant 3 for each hour
  37  ;
  38   
  39  POSITIVE VARIABLES U_solar,U_Coal,U_Gas, Plant1, Plant2, Plant3, Cost;
  40   
  41   
  42   
  43  EQUATIONS
  44  * The equation definition block:
  45  QUS(T)     Equation for Solar Utililzation
  46  QCOAL(T)   Equation for coal utilization
  47  QGAS(T)    Equation for gas utilization
  48  QDemand(T)   Equation for demand satisfaction
  49  QCost(T)   Equation for total cost for each hour
  50  QTOTCost   Equation for total cost for all hours
  51  QPlant1(T)   Equation for Plant 1 production
  52  QPlant2(T)   Equation for Plant 2 production
  53  QPlant3(T)   Equation for Plant 3 production
  54  ;
  55   
  56  * 0.4 (plant 2)= effieceny for coal and 0.5 (plant 3)= efficaieny for gas
  57  QUS(T)..        U_solar(T) =l= 500; #MWh
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/15/26 10:33:15 Page 2
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


  58  QCOAL(T)..      U_Coal(T) =l= 100; #MWh
  59  QGAS(T)..       U_Gas(T) =l= 600; #MWh
  60  *Demand
  61  QDemand(T)..    PRD_DATA(T) =E= U_solar(T) + U_Coal(T) + U_Gas(T) ; #MWh
  62  * cost of each gen
  63  QPlant1(T)..    Plant1(T) =E= 1*U_solar(T);
  64  QPlant2(T)..    Plant2(T) =E= 2*U_Coal(T) + C_coal(T)*U_Coal(T)/0.4; # dollars
  65  QPlant3(T)..    Plant3(T) =E= 2*U_Gas(T) + C_gas(T)*U_Gas(T)/0.5; # Dollars
  66  *Calc cost tot
  67  QCost(T)..      Cost(T) =E= Plant1(T) + Plant2(T) + Plant3(T);
  68  QTOTCost..      TOTCost =E= SUM(T, Cost(T));
  69  MODEL CLIMATE /ALL/;
  70  SOLVE CLIMATE USING lp MINIMIZING TOTCost;
  71   
  72  DISPLAY QDemand.M, TOTCost.L;

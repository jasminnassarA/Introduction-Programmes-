* Interconnected multi-region dispatch model
*
* Regions R1..R4 each have their own demand, generator fleet and renewable
* availability. Regions trade over interconnectors (transport model):
*   - each direction is a separate non-negative flow F(r,rr,T) <= link cap
*   - the receiving region gets (1-loss)*F, so losses stay linear
*   - every MWh sent pays a wheeling cost
* Unserved energy LS(r,T) is penalised at VOLL so the model is always feasible.
* Nuclear is baseload: minimum output min_L*cap and a slow ramp rate.
*
* Inputs  : Inputs\Interconnect_in\*.csv  (generated by make_inputs.py)
* Outputs : %outdir%\Interconnectors_<N>.gdx (+ .xlsx unless --noxlsx)
*
* Flags   : --regions=N   number of active regions (R1..RN), default 2
*           --outdir=DIR  results folder, default Results
*           --noxlsx=1    skip the Excel export
*           --capfile, --linkCap  capacity overrides (see below)
*
* Units: 1 time step = 1 h, so MW and MWh are interchangeable.
$offeolcom
$eolcom #
option lp = mosek;

$if not set outdir  $set outdir Results
$if not set regions $set regions 2
$set indir Inputs\Interconnect_in

SETS
    T        hours                 /1*744/
    r        regions               /R1*R4/
    gen      generators            /Solar,Wind,Coal,Gas,Nuclear/
    f        generator fields      /cost,cap,eff,vom,ramp_L,ramp_cost,min_L/
    lf       interconnector fields /cap,loss,cost/
    col      dispatch report columns
             /Solar,Wind,Coal,Gas,Nuclear,Demand,Import,Export,Unserved/
    ra(r)    active regions
    rg(r,gen) active generators (active region and cap > 0)
    lk(r,r)  active interconnector directions from-to
;
alias (r,rr);

PARAMETERS
    gdata(r,gen,f)       generator data
    dem(T,r)             demand (MWh)
    LF_in(T,r,gen)       availability factor (0-1)
    icdata(r,rr,lf)      interconnector data: cap (MW) loss (fraction) cost ($ per MWh)
    Ramp(r,gen)          max hourly ramp (MW)
    VOLL                 value of lost load ($ per MWh) /10000/
;

$call csv2gdx %indir%\generators.csv id=gdata index=1,2 values=3..9 useHeader=y output=%indir%\generators.gdx
$if errorlevel 1 $abort csv2gdx failed on generators.csv
$gdxin %indir%\generators.gdx
$load gdata
$gdxin

$call csv2gdx %indir%\demand.csv id=dem index=1 values=2..5 useHeader=y output=%indir%\demand.gdx
$if errorlevel 1 $abort csv2gdx failed on demand.csv
$gdxin %indir%\demand.gdx
$load dem
$gdxin

$call csv2gdx %indir%\loadfactors.csv id=LF_in index=1,2 values=3..7 useHeader=y output=%indir%\loadfactors.gdx
$if errorlevel 1 $abort csv2gdx failed on loadfactors.csv
$gdxin %indir%\loadfactors.gdx
$load LF_in
$gdxin

$call csv2gdx %indir%\interconnectors.csv id=icdata index=1,2 values=3..5 useHeader=y output=%indir%\interconnectors.gdx
$if errorlevel 1 $abort csv2gdx failed on interconnectors.csv
$gdxin %indir%\interconnectors.gdx
$load icdata
$gdxin

* Optional overrides from the dashboard:
*   --capfile=<file.gms>  GAMS assignments such as  gdata('R2','Wind','cap') = 750;
*   --linkCap=<MW>        same limit on every existing interconnector direction
$if set capfile $include %capfile%
$if set linkCap icdata(r,rr,'cap')$icdata(r,rr,'loss') = %linkCap%;

ra(r)     = ord(r) <= %regions%;
rg(ra,gen) = gdata(ra,gen,'cap') > 0;
lk(ra,rr)  = ra(rr) and icdata(ra,rr,'cap') > 0;
Ramp(rg)   = gdata(rg,'ramp_L')*gdata(rg,'cap');

abort$(card(ra) <> %regions%) "--regions must be between 1 and 4";

VARIABLES
    TOTCost          total system cost ($)
;
POSITIVE VARIABLES
    U(r,gen,T)       generation (MWh)
    Flow(r,rr,T)        flow sent from r to rr (MWh)
    LS(r,T)          unserved demand (MWh)
    Ramp_U(r,gen,T)  ramp up (MW)
    Ramp_D(r,gen,T)  ramp down (MW)
;

EQUATIONS
    QObj             total cost
    QBal(r,T)        regional energy balance
    QCap(r,gen,T)    available capacity
    QMin(r,gen,T)    minimum stable output (nuclear)
    QVol_U(r,gen,T)  ramp-up volume
    QVol_D(r,gen,T)  ramp-down volume
    QRamp_U(r,gen,T) ramp-up limit
    QRamp_D(r,gen,T) ramp-down limit
    QLink(r,rr,T)    interconnector capacity
;

QObj.. TOTCost =e=
      sum((rg(r,gen),T), (gdata(r,gen,'vom') + gdata(r,gen,'cost')/gdata(r,gen,'eff'))*U(r,gen,T))
    + sum((rg(r,gen),T)$(ord(T)>1), gdata(r,gen,'ramp_cost')*(Ramp_U(r,gen,T) + Ramp_D(r,gen,T)))
    + sum((lk(r,rr),T), icdata(r,rr,'cost')*Flow(r,rr,T))
    + sum((ra,T), VOLL*LS(ra,T));

QBal(ra,T)..
      sum(gen$rg(ra,gen), U(ra,gen,T))
    + sum(lk(rr,ra), (1 - icdata(rr,ra,'loss'))*Flow(rr,ra,T))
    - sum(lk(ra,rr), Flow(ra,rr,T))
    + LS(ra,T)
    =e= dem(T,ra);

QCap(rg(r,gen),T)..  U(r,gen,T) =l= gdata(r,gen,'cap')*LF_in(T,r,gen);
QMin(rg(r,gen),T)$gdata(r,gen,'min_L')..
                     U(r,gen,T) =g= gdata(r,gen,'min_L')*gdata(r,gen,'cap')*LF_in(T,r,gen);

QVol_U(rg(r,gen),T)$(ord(T)>1).. Ramp_U(r,gen,T) =g= U(r,gen,T) - U(r,gen,T-1);
QVol_D(rg(r,gen),T)$(ord(T)>1).. Ramp_D(r,gen,T) =g= U(r,gen,T-1) - U(r,gen,T);
QRamp_U(rg(r,gen),T)$(ord(T)>1).. Ramp_U(r,gen,T) =l= Ramp(r,gen);
QRamp_D(rg(r,gen),T)$(ord(T)>1).. Ramp_D(r,gen,T) =l= Ramp(r,gen);

QLink(lk(r,rr),T).. Flow(r,rr,T) =l= icdata(r,rr,'cap');

MODEL INTERCON /ALL/;
SOLVE INTERCON USING lp MINIMIZING TOTCost;

* ---------------------------------------------------------------- reporting
PARAMETERS
    Dispatch(r,T,col)  hourly dispatch per region (MWh)
    Price(r,T)         regional price = balance marginal ($ per MWh)
    FlowRep(r,rr,T)    flow sent from r to rr (MWh)
    Summary(r,*)       monthly totals per region
;
Dispatch(ra,T,col)        = sum(gen$sameas(gen,col), U.L(ra,gen,T));
Dispatch(ra,T,'Demand')   = dem(T,ra);
Dispatch(ra,T,'Import')   = sum(lk(rr,ra), (1 - icdata(rr,ra,'loss'))*Flow.L(rr,ra,T));
Dispatch(ra,T,'Export')   = sum(lk(ra,rr), Flow.L(ra,rr,T));
Dispatch(ra,T,'Unserved') = LS.L(ra,T);
Price(ra,T)               = QBal.M(ra,T);
FlowRep(lk,T)             = Flow.L(lk,T);

Summary(ra,col)           = sum(T, Dispatch(ra,T,col));
Summary(ra,'AvgPrice')    = sum(T, Price(ra,T))/card(T);

DISPLAY TOTCost.L, Summary;

execute_unload '%outdir%\Interconnectors_%regions%.gdx', Dispatch, Price, FlowRep, Summary, TOTCost, U, Flow, LS, gdata, dem, icdata, ra;

$if not set noxlsx execute 'gdxxrw %outdir%\Interconnectors_%regions%.gdx output=%outdir%\Interconnectors_%regions%.xlsx squeeze=n par=Dispatch rng=Dispatch!A1 rdim=2 par=Price rng=Price!A1 rdim=1 par=FlowRep rng=Flows!A1 rdim=2 par=Summary rng=Summary!A1 rdim=1';

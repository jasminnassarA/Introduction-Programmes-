G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   3   
   4  SETS
   5             SOL       List of all solves
   6                       /"1st solve", "2nd solve", "3rd solve"/
   7              J      List of all elements
   8                       /1 , 2, 3/
   9              T       List of all time periods
  10  * this means all years from 2000 to 2004
  11                      /2000*2004/;
  12   
  13  PARAMETERS
  14  RES(SOL,T)   The result of the solvers
  15  COEF(J,T)    Emission coefficient CO2 for each year
  16  PRD_DATA(J,T)   Input data for production quantity
  17  OTHER(T)   Emissions of other greenhouse gasses for each year
  18  INDEX(T)   Index for time periods;
  19   
  20   
  21  *now these are time dependent parameters, so we can assign values for each year
  22  OTHER(T) = 5;
  23   
  24  TABLE DATA(J,T)     Input data for PRD
  25            2000      2001      2002      2003      2004
  26  1         10        11        12        13        14
  27  2         50        52        54        56        58
  28  3         40        42        44        46        48;
  29   
  30  PRD_DATA(J,T) = DATA(J,T);
  31   
  32  TABLE COEF_DATA(J,T)     Coefficient for each product
  33            2000      2001      2002      2003      2004
  34  1         0.01      0.01      0.01      0.01      0.01
  35  2         0.04       0.04     0.04      0.04      0.04
  36  3         0.025      0.025    0.025     0.025     0.025;
  37   
  38  COEF(J,T) = COEF_DATA(J,T);
  39   
  40  coef("1",T) = 0.01*(0.99**(ORD(T)-1));
  41  coef("2",T) = 0.04*(0.99**(ORD(T)-1));
  42  coef("3",T) = 0.025*(0.99**(ORD(T)-1));
  43   
  44  INDEX(T) = (ORD(T)-1)/(CARD(T)-1);
  45   
  46  VARIABLES
  47   
  48  CO2(T)      Emissions of CO2
  49  PRD(J,T)            Production quantity
  50  EMIS(T)  Total emissions of greenhouse gasses
  51  TOTEMIS Total emissions of greenhouse gasses for all years
  52  DAM(J,T)        Damage costs for each product and year
  53  alpha   Weighting factor for CO2 emissions
  54  ;
  55   
  56  POSITIVE VARIABLES CO2,PRD,EMIS;
  57   
  58  alpha.FX = 0.5;
  59   
  60  PRD.LO("1",T) = 12;
  61  PRD.FX("3","2000") = 45;
  62   
  63  EMIS.L(T) = 6;
  64  CO2.L(T) = 1;
  65   
  66  EQUATIONS
  67  * The equation definition block:
  68  QPRD(J,T)       Equation for economic production
  69  QCO2(T) Equation for CO2 emissions
  70  QEMIS(T)        Equation for total climate emissions
  71  QTOTEMIS        Equation for total emissions
  72  QDAM(J,T)       Equation for damage costs
  73  ;
  74   
  75  QPRD(J,T)..     PRD(J,T) =G= ((1 - DAM(J,T))**2)*(PRD_DATA(J,T));
  76  * Sum over T across all products combined with the emission coefficient for each year
  77  QCO2(T)..       CO2(T) =E= SUM(J,COEF(J,T)*PRD(J,T));
  78  QEMIS(T).. EMIS(T) =E= CO2(T)*alpha*2 + OTHER(T)*(1-alpha)*2;
  79  *sum of EMIS over time
  80  QTOTEMIS..      TOTEMIS =E= SUM(T, EMIS(T));
  81  QDAM(J,T)..   DAM(J,T) =E= 0.05+0.05$(PRD_DATA(J,T-1)>50);
  82   
  83  MODEL CLIMATE /ALL/;
  84  LOOP(SOL,
  85           SOLVE CLIMATE USING DNLP MINIMIZING TOTEMIS;
  86           RES(SOL,T) = EMIS.L(T);
  87           PRD.LO('3','2000')= -INF;
  88           PRD.UP('3','2000')= +INF;
  89           OTHER(T) = OTHER(T)+2;
  90  );
  91  DISPLAY RES,INDEX;
  92   
  93  execute_UNLOAD '3_2_21.gdx', res;
  94  execute 'gdxxrw.exe 3_2_21.gdx par=res';



G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * My attempt at trying to use csv files for simplicity instead of manually entering data
   4  option lp = mosek;
   5   
   6  SETS
   7              T       List of all time Hours
   8  * this means all hours from 1 to 744
   9                      /1*744/
  10              gen     generators
  11                      /Solar,Coal,Gas/
  12              f       diffrent fields
  13                      /cost,cap,eff,vom/
  14              outfield Output columns
  15                      /DemandMarginal,Solar,Coal,Gas/; #cost($/MWhTh),Cap (MW),eff (MWh/MWhTh),vom($/MWh)
  16   
  17   
  18  PARAMETERS
  19  data(gen,f) "Input data for cost, capacity, efficiency, and variable O&M for each generator"
  20  PRD_DATA(T) "Input data for production quantity"
  21  d(T) "Demand for each hour"
  22  ExcelResults(T,outfield) "Values exported to Excel";
  23   
  24  *Note to self = i can assign the values in data(gen,f) to there own Peramerter/Scalar if i think i will get confusing
  25  * Question -> is this better as it is more consice or should i assign each value individually for clarity?
  26   
  27   
  29   
GDXIN   C:\Intro to GAMs\Inputs\base_case.gdx
--- LOAD  data = 1:data_in
  33   
  34   
  35  * Assigning cost for each generator based on the excel input
GDXIN   C:\Intro to GAMs\Inputs\demand(in).gdx
--- LOAD  d = 1:d
  40   
  41  PRD_DATA(T) = d(T); #MWh
  42   
  43  VARIABLES
  44  TOTCost     Total cost of emissions for all hours
  45  Cost(T)     Total cost for each hour
  46  U(gen,T)   Utilization of each generator for each hour
  47  PlantCost(gen,T)   Cost for each generator and hour
  48  ;
  49   
  50  POSITIVE VARIABLES U, PlantCost, Cost;
  51   
  52   
  53   
  54  EQUATIONS
  55  * The equation definition block:
  56  Qcap(gen,T)   Equation for utilization of each generator
  57  QDemand(T)   Equation for demand satisfaction
  58  QCost(T)   Equation for total cost for each hour
  59  QTOTCost   Equation for total cost for all hours
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/15/26 14:21:23 Page 2
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


  60  QPlant(gen,T)   Equation for cost of each generator and hour
  61  ;
  62   
  63   
  64  Qcap(gen,T)..   U(gen,T) =l=data(gen,'cap'); #MWh
  65  QDemand(T)..     sum(gen, U(gen,T)) =E= PRD_DATA(T); #MWh
  66   
  67  * Equations for calculating the production cost for each plant based on utilization and cost parameters
  68  QPlant(gen,T).. PlantCost(gen,T) =E= data(gen,'vom')*U(gen,T) + data(gen,'cost')*U(gen,T)/data(gen,'eff'); # dollars
  69   
  70  * Equations for calculating the total cost for each hour and the total cost for all hours
  71  QCost(T)..      Cost(T) =E= sum(gen, PlantCost(gen,T));
  72  QTOTCost..      TOTCost =E= SUM(T, Cost(T));
  73   
  74  MODEL CLIMATE /ALL/;
  75  SOLVE CLIMATE USING lp MINIMIZING TOTCost;
  76   
  77  DISPLAY QDemand.M, TOTCost.L, U.L;
  78   
  79  ExcelResults(T,'DemandMarginal') = QDemand.M(T);
  80  ExcelResults(T,'Solar') = U.L('Solar',T);
  81  ExcelResults(T,'Coal') = U.L('Coal',T);
  82  ExcelResults(T,'Gas') = U.L('Gas',T);
  83   
  84  execute_unload 'Results\My_First_DM_results.gdx', ExcelResults;
  85   
  86  execute 'gdxxrw Results\My_First_DM_results.gdx output=Results\My_First_DM_results.xlsx squeeze=n par=ExcelResults rng=Hourly!A1';
  87   
  88  *dont run results if infesabile

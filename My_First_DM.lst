C o m p i l a t i o n


   1  * My attempt at trying to use csv files for simplicity instead of manually entering data
   4  option lp = mosek;
   5   
   6  SETS
   7              T       List of all time Hours
   8  * this means all hours from 1 to 744
   9                      /1*744/
  10              gen     generators
  11                      /Solar,Coal,Gas/
  12              f       diffrent fields
  13                      /cost,cap,eff,vom/; #cost($/MWhTh),Cap (MW),eff (MWh/MWhTh),vom($/MWh)
  14   
  15   
  16  PARAMETERS
  17  data(gen,f)   Input data for cost, capacity, efficiency, and variable O&M for each generator
  18  PRD_DATA(T)   Input data for production quantity
  19  d(T)   Demand for each hour;
  20   
  21  *Note to self = i can assign the values in data(gen,f) to there own Peramerter/Scalar if i think i will get confusing
  22  * Question -> is this better as it is more consice or should i assign each value individually for clarity?
  23   
  24   
  26   
GDXIN   C:\Intro to GAMs\Inputs\base_case.gdx
--- LOAD  data = 1:data_in
  30   
  31   
  32  * Assigning cost for each generator based on the excel input
GDXIN   C:\Intro to GAMs\Inputs\demand(in).gdx
--- LOAD  d = 1:d
  37   
  38  PRD_DATA(T) = d(T); #MWh
  39   
  40  VARIABLES
  41  TOTCost     Total cost of emissions for all hours
  42  Cost(T)     Total cost for each hour
  43  U_solar(T)     Utilization of solar energy for each hour
  44  U_Coal(T)     Utilization of coal energy for each hour
  45  U_Gas(T)     Utilization of gas energy for each hour
  46  Plant1(T)   Production for Plant 1 for each hour
  47  Plant2(T)   Production for Plant 2 for each hour
  48  Plant3(T)   Production for Plant 3 for each hour
  49  ;
  50   
  51  POSITIVE VARIABLES U_solar,U_Coal,U_Gas, Plant1, Plant2, Plant3, Cost;
  52   
  53   
  54   
  55  EQUATIONS
  56  * The equation definition block:
  57  QUS(T)     Equation for Solar Utililzation
  58  QCOAL(T)   Equation for coal utilization
  59  QGAS(T)    Equation for gas utilization
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/15/26 10:37:09 Page 2
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


  60  QDemand(T)   Equation for demand satisfaction
  61  QCost(T)   Equation for total cost for each hour
  62  QTOTCost   Equation for total cost for all hours
  63  QPlant1(T)   Equation for Plant 1 production
  64  QPlant2(T)   Equation for Plant 2 production
  65  QPlant3(T)   Equation for Plant 3 production
  66  ;
  67   
  68  * 0.4 (plant 2)= effieceny for coal and 0.5 (plant 3)= efficaieny for gas
  69  QUS(T)..        U_solar(T) =l=data('Solar','cap'); #MWh
  70  QCOAL(T)..      U_Coal(T) =l=data('Coal','cap'); #MWh
  71  QGAS(T)..       U_Gas(T) =l=data('Gas','cap'); #MWh
  72  QDemand(T)..    PRD_DATA(T) =E= U_solar(T) + U_Coal(T) + U_Gas(T) ; #MWh
  73   
  74  * Equations for calculating the production cost for each plant based on utilization and cost parameters
  75  QPlant1(T)..    Plant1(T) =E= data('Solar','vom')*U_solar(T)+ data('Solar','cost')*U_solar(T)/data('Solar','eff');
  76  QPlant2(T)..    Plant2(T) =E= data('Coal','vom')*U_Coal(T) + data('Coal','cost')*U_Coal(T)/data('Coal','eff'); # dollars
  77  QPlant3(T)..    Plant3(T) =E= data('Gas','vom')*U_Gas(T) + data('Gas','cost')*U_Gas(T)/data('Gas','eff'); # Dollars
  78   
  79  * Equations for calculating the total cost for each hour and the total cost for all hours
  80  QCost(T)..      Cost(T) =E= Plant1(T) + Plant2(T) + Plant3(T);
  81  QTOTCost..      TOTCost =E= SUM(T, Cost(T));
  82   
  83  MODEL CLIMATE /ALL/;
  84  SOLVE CLIMATE USING lp MINIMIZING TOTCost;
  85   
  86  DISPLAY QDemand.M, TOTCost.L;
  87   

**** LIST OF STRAY NAMES - CHECK DECLARATIONS FOR SPURIOUS COMMAS
**** STRAY NAME capacity OF TYPE PARAM
**** STRAY NAME efficiency OF TYPE PARAM
**** STRAY NAME and OF TYPE PARAM

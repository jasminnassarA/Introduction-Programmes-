G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   3  option lp = mosek;
   4   
   5  SETS
   6              J      List of Plants available
   7                       /1 , 2, 3/
   8              T       List of all time Hours
   9  * this means all hours from 1 to 744
  10                      /1*744/;
  11   
  12  PARAMETERS
  13  C_coal(T)     Cost of coal per unit for each hour
  14  C_gas(T)      Cost of gas per unit for each hour
  15  C_solar(T)    Cost of solar per unit for each hour
  16  PRD_DATA(T)   Input data for production quantity
  17  MAX_Marg(T)   Maximum marginal cost for each hour
  18  d(T)   Demand for each hour;
  19   
  20  C_coal(T) = 7.8; # $/MWhTh
  21  C_gas(T) = 19.8; # $/MWhTh
  22  C_solar(T) = 1;# $/MWhTh
  23   
  24   
  25   
GDXIN   C:\Intro to GAMs\demand.gdx
--- LOAD  d = 1:d
  30   
  31   
  32  PRD_DATA(T) = d(T); #MWh
  33   
  34  VARIABLES
  35  TOTCost     Total cost of emissions for all hours
  36  Cost(T)     Total cost for each hour
  37  U_solar(T)     Utilization of solar energy for each hour
  38  U_Coal(T)     Utilization of coal energy for each hour
  39  U_Gas(T)     Utilization of gas energy for each hour
  40  Plant1(T)   Production for Plant 1 for each hour
  41  Plant2(T)   Production for Plant 2 for each hour
  42  Plant3(T)   Production for Plant 3 for each hour
  43  ;
  44   
  45  POSITIVE VARIABLES U_solar,U_Coal,U_Gas, Plant1, Plant2, Plant3, Cost;
  46   
  47   
  48   
  49  EQUATIONS
  50  * The equation definition block:
  51  QUS(T)     Equation for Solar Utililzation
  52  QCOAL(T)   Equation for coal utilization
  53  QGAS(T)    Equation for gas utilization
  54  QDemand(T)   Equation for demand satisfaction
  55  QCost(T)   Equation for total cost for each hour
  56  QTOTCost   Equation for total cost for all hours
  57  QPlant1(T)   Equation for Plant 1 production
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/14/26 14:43:23 Page 2
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


  58  QPlant2(T)   Equation for Plant 2 production
  59  QPlant3(T)   Equation for Plant 3 production
  60   
  61  ;
  62   
  63  * 0.4 (plant 2)= effieceny for coal and 0.5 (plant 3)= efficaieny for gas
  64  QUS(T)..        U_solar(T) =l= 500; #MWh
  65  QCOAL(T)..      U_Coal(T) =l= 100; #MWh
  66  QGAS(T)..       U_Gas(T) =l= 600; #MWh
  67  *Demand with effieicency included
  68  QDemand(T)..    PRD_DATA(T) =E= U_solar(T)*1 + U_Coal(T)*0.4 + U_Gas(T)*0.5 ; #MWh
  69  * Sum over T across all products combined with the emission coefficient for each year
  70  *its an lp sovler so cant use booleon
  71  *QCost(T)..     Cost(T) =E= 1+ (C_coal(T)*U_Coal(T) +2)$ (U_Coal(T) > 0) + (C_gas(T)*U_Gas(T)+2)$ (U_Gas(T) > 0);
  72  QPlant1(T)..    Plant1(T) =E= C_solar(T)*U_solar(T); #C_solar=1
  73  QPlant2(T)..    Plant2(T) =E= 2*U_Coal(T)*0.4 + C_coal(T)*U_Coal(T); # dollars
  74  QPlant3(T)..    Plant3(T) =E= 2*U_Gas(T)*0.5 + C_gas(T)*U_Gas(T); # Dollars
  75   
  76  QCost(T)..      Cost(T) =E= Plant1(T) + Plant2(T) + Plant3(T);
  77  QTOTCost..      TOTCost =E= SUM(T, Cost(T));
  78   
  79  MODEL CLIMATE /ALL/;
  80  SOLVE CLIMATE USING lp MINIMIZING TOTCost;
  81   
  82  DISPLAY Cost.L, Cost.M, TOTCost.L;
  83   
  84  *MAX_Marg(T) = MAX(QPlant1(T), QPlant2(T), QPlant3(T));
  85   
  86  *DISPLAY MAX_Marg;
  87   
  88   
  89   
  90   

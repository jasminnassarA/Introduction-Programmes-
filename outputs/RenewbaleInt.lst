G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * My attempt at trying to use csv files for simplicity instead of manually entering data
   4  option lp = mosek;
   5   
   6  SETS
   7              T       List of all time Hours
   8  * this means all hours from 1 to 744
   9                      /1*744/
  10              gen     generators
  11                      /Solar,Coal,Gas,Wind/
  12              f       diffrent fields
  13                      /cost,cap,eff,vom/
  14              outfield Output columns
  15                      /DemandMarginal,Demand,Solar,Coal,Gas,Wind/; #cost($/MWhTh),Cap (MW),eff (MWh/MWhTh),vom($/MWh)
  16   
  17   
  18  PARAMETERS
  19  data(gen,f) Input data for cost, capacity, efficiency, and variable O&M for each generator
  20  PRD_DATA(T) Input data for production quantity
  21  d(T) Input data for demand for each hour
  22  Load_factor(T,gen) Input data for load factor for each hour
  23  ExcelResults(T,outfield) Values exported to Excel;
  24   
  25  *Note to self = i can assign the values in data(gen,f) to there own Peramerter/Scalar if i think i will get confusing
  26  * Question -> is this better as it is more consice or should i assign each value individually for clarity?
  27   
  28   
  30   
GDXIN   C:\Intro to GAMs\Inputs\Renewable_intermit.gdx
--- LOAD  data = 1:data_in
  34   
  35  * Optional overrides passed from the dashboard (defaults keep the original behaviour)
  41   
  42   
  43  * Assigning cost for each generator based on the excel input
GDXIN   C:\Intro to GAMs\Inputs\demand(in).gdx
--- LOAD  d = 1:d
  48   
GDXIN   C:\Intro to GAMs\Inputs\normalisedloads.gdx
--- LOAD  Load_factor = 1:Load_factor
  53   
  54  PRD_DATA(T) = d(T); #MWh
  55   
  56   
  57  VARIABLES
  58  TOTCost     Total cost of emissions for all hours
  59  Cost(T)     Total cost for each hour
  60  U(gen,T)   Utilization of each generator for each hour
  61  PlantCost(gen,T)   Cost for each generator and hour
  62  ;
  63   
  64  POSITIVE VARIABLES U, PlantCost, Cost;
  65   
  66   
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/19/26 17:58:02 Page 2
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


  67   
  68  EQUATIONS
  69  * The equation definition block:
  70  Qcap(gen,T)   Equation for utilization of each generator
  71  QDemand(T)   Equation for demand satisfaction
  72  QCost(T)   Equation for total cost for each hour
  73  QTOTCost   Equation for total cost for all hours
  74  QPlant(gen,T)   Equation for cost of each generator and hour
  75  ;
  76   
  77   
  78  Qcap(gen,T)..   U(gen,T) =l=data(gen,'cap')*Load_factor(T,gen); #MWh
  79  QDemand(T)..     sum(gen, U(gen,T)) =E= PRD_DATA(T); #MWh
  80   
  81  * Equations for calculating the production cost for each plant based on utilization and cost parameters
  82  QPlant(gen,T).. PlantCost(gen,T) =E= data(gen,'vom')*U(gen,T) + data(gen,'cost')*U(gen,T)/data(gen,'eff'); # dollars
  83   
  84  * Equations for calculating the total cost for each hour and the total cost for all hours
  85  QCost(T)..      Cost(T) =E= sum(gen, PlantCost(gen,T));
  86  QTOTCost..      TOTCost =E= SUM(T, Cost(T));
  87   
  88  MODEL CLIMATE /ALL/;
  89  SOLVE CLIMATE USING lp MINIMIZING TOTCost;
  90   
  91  DISPLAY QDemand.M, TOTCost.L, U.L;
  92   
  93  ExcelResults(T,'DemandMarginal') = QDemand.M(T);
  94  ExcelResults(T,'Demand') = d(T); #MWh
  95  ExcelResults(T,'Solar') = U.L('Solar',T);
  96  ExcelResults(T,'Coal') = U.L('Coal',T);
  97  ExcelResults(T,'Gas') = U.L('Gas',T);
  98  ExcelResults(T,'Wind') = U.L('Wind',T);
  99   
 100  execute_unload 'Results\Renewable_intermit.gdx', ExcelResults;
 101   
 102  execute 'gdxxrw Results\Renewable_intermit.gdx output=Results\Renewable_intermit.xlsx squeeze=n par=ExcelResults rng=Hourly!A1';
 103   
 104   
 105  *dont run results if infesabile


GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/20/26 10:49:30 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * =====================================================================
   2  * Nodal_SC.gms
   3  * Nodal pricing scenario: least-cost dispatch under transmission
   4  * constraints (DC power flow via shift factors / PTDF).
   5  * All input data are read from csv files in Inputs\Nodes_in.
   6  * =====================================================================
   7  *
   8  * ---------------------------- ASSUMPTIONS ----------------------------
   9  *  A1. Each time step T is 1 hour (168 hours = 1 week), 1 MW for 1 h = 1 MWh.
  10  *  A2. Generator data (Inputs\Nodes_in\generators(in).csv):
  11  *        MC   = marginal cost                                  ($ per MWh)
  12  *        CAP  = maximum output, constant in every hour         (MW)
  13  *        NODE = node the generator is connected to
  14  *      No ramping, minimum output, efficiency or O&M terms.
  15  *  A3. DC power flow with shift factors: the flow on line l is
  16  *        Flow(l,t) = sum(n, PTDF(l,n) * NetInj(n,t))
  17  *      NetInj = generation + unserved energy - demand at node n.
  18  *      The PTDF column of the reference (slack) bus is zero.
  19  *  A4. Flows are tracked on ALL lines. Only lines with a finite rating
  20  *      get +/- rating limits. Lines rated "inf" are unlimited.
  21  *  A5. One system-wide energy balance per hour (lossless network).
  22  *  A6. Unserved energy LS(n,t) is allowed at demand nodes at VOLL
  23  *      (10 000 $/MWh), which keeps the LP always feasible.
  24  *  A7. Nodal price (LMP) = system energy price + congestion component:
  25  *        LMP(n,t) = QBal.M(t) + sum(l, PTDF(l,n)*(QFmax.M(l,t)+QFmin.M(l,t)))
  26  *      (QFmax.M <= 0, QFmin.M >= 0 in GAMS sign conventions.)
  27  *
  28  * ---------------------------- EQUATIONS ------------------------------
  29  *   QObj     TOTCost = sum(g,t, MC(g)*P(g,t)) + VOLL*sum(n,t, LS(n,t))
  30  *   QBal     sum(g, P(g,t)) + sum(n, LS(n,t)) = sum(n, dem(t,n))
  31  *   QFlow    Flow(l,t) = sum(n, PTDF(l,n)*NetInj(n,t))       all lines
  32  *   QFmax    Flow(l,t) <=  rating(l)                         finite only
  33  *   QFmin    Flow(l,t) >= -rating(l)                         finite only
  34  *   Bounds   0 <= P(g,t) <= CAP(g),  LS(n,t) >= 0
  35  * =====================================================================
  38  option lp = mosek, limrow = 0, limcol = 0, solprint = off;
  39   
  42   
  43  SETS
  44      T     hours /1*168/
  45      l     transmission lines
  46      n     network nodes
  47      g     generators
  48      f     generator fields
  49      dn(n) nodes with demand
  50      gn(g,n) generator-to-node map
  51  ;
  52   
  53  PARAMETERS
  54      ptdf(l,n)     shift factor of node n on line l (MW per MW)
  55      rating(l)     thermal rating of line l (MW)
  56      dem(T,n)      hourly demand per node (MWh)
  57      gdata(g,n,f)  generator data indexed by its node
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/20/26 10:49:30 Page 2
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


  58      MC(g)         marginal cost ($ per MWh)
  59      CAP(g)        capacity (MW)
  60      VOLL          value of lost load in $ per MWh /10000/
  61  ;
  62   
  63  * ---------------- Shift factor matrix (defines lines and nodes) ----------------
GDXIN   C:\Intro to GAMs\Inputs\Nodes_in\shiftfactormatrix(in).gdx
--- LOAD  l = 2:Dim1
--- LOAD  n = 3:Dim2
--- LOAD  ptdf = 1:ptdf
  68   
  69  * ---------------- Line ratings ("inf" -> +INF) ----------------
GDXIN   C:\Intro to GAMs\Inputs\Nodes_in\lineratings(in).gdx
--- LOAD  rating = 1:rating
  74   
  75  * ---------------- Hourly demand by node ----------------
  76  * The reference (slack) bus has an all-zero PTDF column, so csv2gdx drops it from
  77  * the shift factor gdx. Merge the demand nodes (and generator nodes below) into n
  78  * with $loadM so no demand is filtered out by the domain check.
GDXIN   C:\Intro to GAMs\Inputs\Nodes_in\hourlydemandbynode(in).gdx
--- MERGE n = 3:Dim2
--- LOAD  dem = 1:dem
  84  PARAMETER demRaw(*,*) demand without domain checking (for the completeness check);
GDXIN   C:\Intro to GAMs\Inputs\Nodes_in\hourlydemandbynode(in).gdx
--- LOAD  demRaw = 1:dem
  88   
  89  * ---------------- Generators (NODE column used as 2nd index) ----------------
GDXIN   C:\Intro to GAMs\Inputs\Nodes_in\generators(in).gdx
--- MERGE n = 3:Dim2
--- LOAD  g = 2:Dim1
--- LOAD  f = 4:Dim3
--- LOAD  gdata = 1:gdata
  95   
  96  SCALAR demCheck total demand loaded minus csv total (must be 0);
  97  ALIAS (*, u1, u2);
  98  demCheck = sum((T,n), dem(T,n)) - sum((u1,u2)$demRaw(u1,u2), demRaw(u1,u2));
  99  ABORT$(abs(demCheck) > 1e-6) "Demand was dropped while loading", demCheck;
 100  gn(g,n)$gdata(g,n,'CAP') = yes;
 101  MC(g)    = sum(gn(g,n), gdata(g,n,'MC'));
 102  CAP(g)   = sum(gn(g,n), gdata(g,n,'CAP'));
 103  dn(n)    = yes$sum(T, dem(T,n));
 104   
 105  SCALAR nInfLines number of unlimited lines, nLimLines number of rated lines;
 106  nInfLines = sum(l$(rating(l) = inf), 1);
 107  nLimLines = sum(l$(rating(l) < inf), 1);
 108  DISPLAY nInfLines, nLimLines, MC, CAP, gn;
 109  ABORT$(nInfLines + nLimLines <> card(l)) "Line ratings missing for some lines", rating;
 110   
 111  VARIABLES
 112      TOTCost       total dispatch cost                         ($)
 113      Flow(l,T)     flow on line l                              (MW)
 114  ;
 115  POSITIVE VARIABLES
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/20/26 10:49:30 Page 3
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


 116      P(g,T)        generation                                  (MWh)
 117      LS(n,T)       unserved energy                             (MWh)
 118  ;
 119  P.up(g,T) = CAP(g);
 120  LS.fx(n,T)$(not dn(n)) = 0;
 121   
 122  EQUATIONS
 123      QObj          objective
 124      QBal(T)       system energy balance
 125      QFlow(l,T)    shift factor flow definition (all lines)
 126      QFmax(l,T)    line limit positive direction (finite ratings)
 127      QFmin(l,T)    line limit negative direction (finite ratings)
 128  ;
 129   
 130  QObj..  TOTCost =E= sum((g,T), MC(g)*P(g,T)) + VOLL*sum((dn,T), LS(dn,T)); # $
 131   
 132  QBal(T).. sum(g, P(g,T)) + sum(dn, LS(dn,T)) =E= sum(dn, dem(T,dn)); # MWh
 133   
 134  QFlow(l,T).. Flow(l,T) =E= sum(n, ptdf(l,n)*( sum(gn(g,n), P(g,T))
 135                                               + LS(n,T)$dn(n)
 136                                               - dem(T,n) )); # MW
 137   
 138  QFmax(l,T)$(rating(l) < inf)..  Flow(l,T) =L=  rating(l);
 139  QFmin(l,T)$(rating(l) < inf)..  Flow(l,T) =G= -rating(l);
 140   
 141  MODEL NODAL /ALL/;
 142  SOLVE NODAL USING lp MINIMIZING TOTCost;
 143   
 144  * ---------------- Post-processing ----------------
 145  SETS
 146      pn(n)  nodes reported in LMP sheet
 147      dcol   dispatch columns /SystemPrice, TotalDemand, Unserved/
 148      fcol   flow columns /Flow, Rating, CongestionPrice/
 149  ;
 150  pn(n) = dn(n) + sum(g, gn(g,n));
 151   
 152  PARAMETERS
 153      LMP(T,n)            nodal price                           ($ per MWh)
 154      CongPrice(l,T)      shadow price of line limit             ($ per MWh)
 155      Dispatch(T,*)       hourly dispatch report
 156      LMPrep(T,n)         LMP at demand and generator nodes
 157      FlowRep(l,T,fcol)   line flow report
 158      LMPcheck(T)         max - min LMP over reported nodes
 159  ;
 160  CongPrice(l,T) = (QFmax.M(l,T) + QFmin.M(l,T))$(rating(l) < inf);
 161  LMP(T,n) = QBal.M(T) + sum(l, ptdf(l,n)*CongPrice(l,T));
 162  LMPrep(T,pn) = LMP(T,pn) + eps;
 163  LMPcheck(T) = smax(pn, LMP(T,pn)) - smin(pn, LMP(T,pn));
 164   
 165  Dispatch(T,g)             = P.L(g,T) + eps;
 166  Dispatch(T,'SystemPrice') = QBal.M(T) + eps;
 167  Dispatch(T,'TotalDemand') = sum(dn, dem(T,dn));
 168  Dispatch(T,'Unserved')    = sum(dn, LS.L(dn,T)) + eps;
GAMS 25.1.3  r4e34d435fbd Released Oct 30, 2018 WEX-WEI x86 64bit/MS Windows                                                                                                                                                           10/20/26 10:49:30 Page 4
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


 169   
 170  FlowRep(l,T,'Flow')            = Flow.L(l,T) + eps;
 171  FlowRep(l,T,'Rating')$(rating(l) < inf) = rating(l);
 172  FlowRep(l,T,'CongestionPrice') = abs(CongPrice(l,T)) + eps;
 173   
 174  SCALAR totUnserved total unserved energy (MWh), nCongested number of congested line-hours;
 175  totUnserved = sum((dn,T), LS.L(dn,T));
 176  nCongested  = sum((l,T)$(CongPrice(l,T) <> 0), 1);
 177  * Sanity check: a generator strictly between 0 and CAP is marginal,
 178  * so the LMP at its node must equal its MC.
 179  PARAMETER MargCheck(g,T) LMP minus MC for marginal generators;
 180  MargCheck(g,T)$(P.L(g,T) > 1e-4 and P.L(g,T) < CAP(g) - 1e-4)
 181      = sum(gn(g,n), LMP(T,n)) - MC(g) + eps;
 182  SCALAR maxMargErr largest abs LMP-MC gap at marginal units;
 183  maxMargErr = smax((g,T), abs(MargCheck(g,T)));
 184  DISPLAY TOTCost.L, totUnserved, nCongested, maxMargErr, LMPcheck;
 185   
 186  execute_unload 'Results\Nodal_SC.gdx', Dispatch, LMP, LMPrep, FlowRep, CongPrice, P, LS, Flow, TOTCost, ptdf, rating, dem;
 187   

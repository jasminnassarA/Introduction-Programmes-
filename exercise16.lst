  15  Variables
  16      tax          "cost"
  17      damage      "damage per hector due to grazing"
  18      st_rate      "stocking rate = number of cattle per hector"
  19      cattle       "number of cattle in the field"
  20      obj          "objective function"
  21      ;
  22   
  23  Positive Variables tax,cattle,st_rate,damage;
  24   
  25  Equations
  26      eq_cat     "Explanatory text on the meaning of the equation for X1"
  27      eq_sr     "Explanatory text on the meaning of the equation for X2"
  28      eq_dam      "Explanatory text on the meaning of the equation for Y"
  29      eq_obj
  30      ;
  31   
  32  eq_cat..    cattle =E= cattle0 + taxcoef*tax;
  33  eq_sr..     st_rate =E= cattle/A;
  34  eq_dam..    damage =E= cost*st_rate*st_rate*A;
  35  eq_obj..    obj =E= (benefit - tax)*cattle - damage;
  36   
  37  tax.fx = 0;
  38   
  39  MODEL TEST /ALL/;
  40  SOLVE TEST USING DNLP MAXIMIZING obj;


